APP_NAME="Sandwell Pharmacy Group"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.up.railway.app

# Tunnels and platform proxies terminate TLS upstream; without this Laravel
# generates http:// asset URLs and the browser blocks them as mixed content.
FORCE_HTTPS=true

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=sqlite

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
MAIL_MAILER=log
